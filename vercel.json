{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "",
  "buildCommand": "sed -i \"s/__BUILD__/$(echo ${VERCEL_GIT_COMMIT_SHA:-local} | cut -c1-7)/g\" index.html",
